# Operator-supplied secrets and host-specific config.
# This file MUST never be committed.
.env

# Backups of pre-restructure files (kept on host disk for rollback,
# not part of this repo).
*.bak
*.bak-*

# Local dumps and rollback copies. Real backups live on /mnt/storage/ruth-backups
# (the root disk is small); never commit database dumps.
backups/
